VITE_JIKAN_BASE_URL=https://api.jikan.moe/v4
VITE_ANILIST_URL=https://graphql.anilist.co

# ---------- Admin analytics (used by server/index.js, never sent to the browser) ----------
# Password for /admin. If you leave this out, the server prints a random temporary one on start.
ADMIN_PASSWORD=change-me-to-a-long-password
# Optional: any random string. Keeps you logged in across server restarts.
# ADMIN_SECRET=
# PORT=3001
# Where the analytics JSON file lives (default: server/data/analytics.json)
# DATA_FILE=server/data/analytics.json
# Days of history to keep (default 45)
# RETENTION_DAYS=45
# Your site's own hostnames, so visits from your own pages aren't counted as "referrals"
# SITE_HOSTS=animehai.in,localhost
# Only if the website is hosted on a DIFFERENT domain than this server (e.g. site on Netlify):
# CORS_ORIGIN=https://animehai.in
# Set to 1 when the server runs behind a proxy/load balancer (Render, Railway, nginx ...)
# TRUST_PROXY=1

# Frontend only: set when the API lives on another domain than the website
# VITE_API_BASE_URL=https://api.animehai.in
